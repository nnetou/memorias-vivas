# Copy this file to both .env and backend/.env for local Docker Compose use.
# Replace placeholder provider keys before starting the API.
APP_ENV=development
GROQ_API_KEY=replace_with_groq_api_key
GOOGLE_API_KEY=replace_with_google_api_key

# API connects to the Compose service hostname `db`.
DATABASE_URL=postgresql+asyncpg://memorias_user:super_secret_password@db:5432/memorias_vivas
REDIS_URL=redis://redis:6379/0

# Compose reads these values from the repository-root .env.
POSTGRES_USER=memorias_user
POSTGRES_PASSWORD=super_secret_password
POSTGRES_DB=memorias_vivas

# Set a unique secret outside local development.
SECRET_KEY=replace_with_a_long_random_secret
